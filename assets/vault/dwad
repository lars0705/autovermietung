.content_container {
  display: flex;
  gap: 20px;
  padding: 20px;
  min-width: 90%;
  margin: 100px auto; /* Abstand nach unten & oben für den Header */
  background: #131313; /* Dunkleres Grau für modernen Look */
  border-radius: 15px;
}

.content_container h2, .content_container h3 {
  margin-bottom: 15px;
  border-bottom: 3px solid red;
  padding-bottom: 5px;
}

.upcoming_bookings_container {
  background: #2b2b2b;
  padding: 5px;
  border-radius: 10px;
  min-width: 295.8px;
}

.scrolling_frame {
  max-height: 90%;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 10px;
}

.upcoming_booking_frame {
  display: flex;
  align-items: center;
  background: #1e1e1e;
  padding: 10px;
  border-radius: 8px;
  border: 2px solid #444;
  transition: box-shadow 0.2s ease-in-out;
}

.upcoming_booking_frame:hover {
  box-shadow: 0 0 10px white;
}

.upcoming_booking_frame img {
  width: 90px;
  margin-right: 10px;
}

/* Startdatum */
.start_date {
  font-size: 14px;
  color: #aaa;
}

.feedback_button_container {
  display: flex;
  justify-content: center;
  margin-top: 20px;
}

.feedback_button {
  background: red;
  padding: 10px;
  border: 1px solid red;
  color: white;
  border-radius: 5px;
  font-size: 14px;
  font-weight: bold;
  border-radius: 5px;
  text-decoration: none;
  display: inline-block;
}

.feedback_button:hover {
  background: #420b0b;
  border: 1px solid white;
}

.success_message {
  padding: 15px;
  background: green;
  border-radius: 8px;
  text-align: center;
  font-size: 20px;
  font-weight: bold;
}

.bookings_table {
  width: 100%;
  border-spacing: 0;
  background: #2b2b2b; /* Dunkleres Grau für einen edlen Look */
  overflow: hidden;
}

.bookings_table th {
  background: #420b0b;
  padding: 15px;
  border: 1px solid #ddd;
}

.bookings_table td {
  border: 1px solid #ddd;
  padding: 12px;
  font-size: 14px;
  color: #ddd; /* Helles Grau für bessere Lesbarkeit */
}

.bookings_table tr:hover {
  background: rgba(255, 255, 255, 0.1);
}

.cancel_button {
  background: red;
  color: white;
  padding: 10px;
  border: 1px solid red;
  border-radius: 5px;
}
.cancel_button:hover {
  background: #420b0b;
  border: 1px solid white;
}


